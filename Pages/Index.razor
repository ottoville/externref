@page "/"
@inject Microsoft.Extensions.Localization.IStringLocalizer<Index> Loc

@inject IJSRuntime JSRuntime;
@code {
    void loginFB(PointerEventArgs e)
    {
        JSRuntime.InvokeAsync<object>("login", e, "facebook");
    }
    void loginAnom(PointerEventArgs e)
    {
        JSRuntime.InvokeAsync<object>("login", e, "anomyous");
    }
}

<div id="loginscreen" class="page">

    @inject NavigationManager NavigationManager

    <h3>Select your language</h3>
    <CultureSelector />


    <h3>Log in to play the game</h3>
    <fieldset id="loginmethods">
        <button @onpointerdown=loginFB>@Loc["🎮 Login with facebook"]</button>
        <br /><br />
              <button @onpointerdown=loginAnom>@Loc["🎮 Continue without logging in and online features"]</button>

</fieldset>
</div>