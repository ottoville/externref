@page "/"

@inject IJSRuntime JSRuntime;
@code {
    void loginFB()
    {
        JSRuntime.InvokeAsync<object>("FB.login", null, new {scope = "email"});
    }
}

<div id="loginscreen" class="page">
    <h3>Log in to play the game</h3>
    <fieldset id="loginmethods">
        <button @onclick=loginFB>Login with facebook</button>
        <!--  <div class="fb-login-button" data-width="" data-scope="email" data-size="large" data-button-type="continue_with" data-auto-logout-link="false" data-use-continue-as="false"></div> -->
        <br /><br />
        <NavLink class="nav-link" href="game">
            🎮 Continue without logging in and online features
        </NavLink>
    </fieldset>
</div>