@page "/"

@inject IJSRuntime JSRuntime;
@code {
    void loginFB()
    {
        JSRuntime.InvokeAsync<object>("FB.login", null, new {scope = "email"});
    }
    void loginAnom(PointerEventArgs e)
    {
        JSRuntime.InvokeAsync<PointerEventArgs>("playAnomyous", e);
    }
}

<div id="loginscreen" class="page">
    <h3>Log in to play the game</h3>
    <fieldset id="loginmethods">
        <button @onclick=loginFB>🎮 Login with facebook</button>
        <br /><br />
        <button  @onpointerdown=loginAnom>🎮 Continue without logging in and online features</button>

    </fieldset>
</div>