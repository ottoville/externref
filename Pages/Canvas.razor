@page "/game"
@inject IJSRuntime JSRuntime;

@code {
    ElementReference canvas;
    sbyte gameSpeed = 0;
    long lastStateChangeGameTime = 216000000000; //21600000 * 10000; //6 hours
    long lastStateChangeTime = DateTime.Now.Ticks;
    string currentGameTime;
    [JSInvokable]
    public void initGame(System.Text.Json.JsonElement input)
    {
        input.GetProperty("lastStateChangeGameTime").TryGetInt64(out lastStateChangeGameTime);
        input.GetProperty("lastStateChangeTime").TryGetInt64(out lastStateChangeTime);
        input.GetProperty("gameSpeed").TryGetSByte(out gameSpeed);
        System.Threading.Timer timer = new System.Threading.Timer((e) =>
        {
            var curDate = new DateTime(getGameTime());
            currentGameTime = curDate.ToShortDateString() + " " + curDate.ToShortTimeString();
            StateHasChanged();
        }, null, TimeSpan.Zero, TimeSpan.FromMilliseconds(1000));
    }

    protected override void OnAfterRender(bool firstrender)
    {

        if (firstrender)
        {
            progress = 0;
            JSRuntime.InvokeAsync<object>("initCanvas", DotNetObjectReference.Create(this), lastStateChangeTime, canvas);
        }
    }
    [JSInvokable]
    public void setProgress(byte p, string error=null)
    {
        if(error != null)
        {
            progressError = error;
        }
        progress = p;
    }
    [JSInvokable]
    public Int64 getGameTime()
    {
        if (gameSpeed < 0)
            return lastStateChangeGameTime;
        var interval = DateTime.Now.Ticks - lastStateChangeTime;
        return lastStateChangeGameTime + ((interval * 60) << gameSpeed);
    }
    void changeState(ChangeEventArgs e)
    {
        lastStateChangeGameTime = getGameTime();
        gameSpeed = SByte.Parse(e.Value.ToString());
        lastStateChangeTime = DateTime.Now.Ticks;
        JSRuntime.InvokeAsync<object>("scene.stateChange", new { lastStateChangeGameTime, gameSpeed, lastStateChangeTime });
    }
    static double[] rotateMatrix(double rad, char axis)
    {
        // https://www.3dgep.com/3d-math-primer-for-game-programmers-matrices/#Rotation
        // if (axis == "x")
        //{
        return new double[16] {
                1, 0, 0, 0,
                0, Math.Cos(rad), Math.Sin(rad) * -1d, 0,
                0, Math.Sin(rad), Math.Cos(rad), 0,
                0, 0, 0, 1
            };
        // }
    }
    static void translate(ref double[] position, double[] m)
    {
        position = new double[4] {
            position[0] * m[0] + position[1] * m[1] + position[2] * m[2] + m[3],
            position[0] * m[4] + position[1] * m[5] + position[2] * m[6] + m[7],
            position[0] * m[8] + position[1] * m[9] + position[2] * m[10] + m[11],
            position[0] * m[12] + position[1] * m[13] + position[2] * m[14] + m[15]
        };
    }
    static double anglePerMinute = (Math.PI * 2) / 1439;
    static double anglePerSecond = anglePerMinute / 60;
    static long sundistance = 149600000000;
    static double[] sunm = rotateMatrix(Math.PI * 0.2, 'x');
    static double meridian = Math.PI * 0.95;
    [JSInvokable]
    public double[] sunPosition()
    {
        var secondsOfDay = (getGameTime() / 10000000) % 86400;
        var sunAngle = ((secondsOfDay * anglePerSecond) + meridian);
        double[] position = new double[3] {
            sundistance*Math.Sin(sunAngle),
            sundistance*Math.Cos(sunAngle),
            0
        };
        translate(ref position, sunm);
        return position;
    }
    Tuple<string, string, string>[] tools2 = new Tuple<string, string, string>[] {
        new Tuple<string, string, string>("Zones",      "▧" , "Zones"),
        new Tuple<string, string, string>("Plants",     "🌲", "Plants"),
        new Tuple<string, string, string>("Buildings",  "🏠", "Buildings"),
        new Tuple<string, string, string>("Camera",     "📷", "Camera"),
        new Tuple<string, string, string>("Terrain",    "🗻", "TerrainTool") };
    public string showMenu;
    void activateMenu(string tool)
    {
        if(showMenu == tool)
        {
            showMenu=null;
            JSRuntime.InvokeAsync<string>("scene.tools." + tool + ".deactivate");
        } else
        {
            showMenu = tool;
            System.Console.WriteLine("activateMenu " + tool);
            JSRuntime.InvokeAsync<string>("scene.tools." + tool + ".activate");

            foreach (Tuple<string, string, string> t in tools2)
            {
                if (t.Item3 != tool)
                {
                    JSRuntime.InvokeAsync<string>("scene.tools." + t.Item3 + ".deactivate");
                }
            }
        }

    }
    byte progress = 0;
    string progressError = null;
}
<canvas id="renderCanvas" class="gameControl hidden" style="float:left;width:100%;height:100%" @ref="canvas"></canvas>
<fieldset class="w3-bar w3-light-grey w3-border w3-top" style="top:15px; overflow: visible;">
    @foreach (var tool in tools2)
    {
    <div class="w3-dropdown-click">
        <button class="w3-bar-item w3-button @(showMenu==tool.Item3?"w3-green":"")" @onclick="@(e => { activateMenu(tool.Item3); })" style="float:none">@tool.Item2</button>
        <fieldset class="w3-dropdown-content w3-card-4 w3-show">
            @if (tool.Item1 == "Zones" && showMenu == "Zones")
            {
                <Zones></Zones>
            }
            @if (tool.Item1 == "Plants" && showMenu == "Plants")
            {
                <Plants></Plants>
            }
            @if (tool.Item1 == "Camera" && showMenu == "Camera")
            {
                <Camera></Camera>
            }
            @if (tool.Item1 == "Buildings" && showMenu == "Buildings")
            {
                <Buildings></Buildings>
            }
            @if (tool.Item1 == "Terrain" && showMenu == "TerrainTool")
            {
                <Terrain></Terrain>
            }
        </fieldset>
    </div>
    }
    </fieldset>
<fieldset class="gameControl hidden" id="gameState" style="position:absolute;bottom:15px;right:15px;background-color:white">
    <label>Time of day: <output id="TODout" fow="TOD">@currentGameTime</output></label>
    <br />
    <input name="time" type="radio" id="pause" value="-1" checked="@(gameSpeed == -1)" @onchange="@changeState" />
    <label for="pause">⏸️</label>
    <input name="time" type="radio" id="play" value="0" checked="@(gameSpeed == 0)" @onchange="@changeState" />
    <label for="play">▶️</label>
    <input name="time" type="radio" id="fastforward" value="1" checked="@(gameSpeed == 1)" @onchange="@changeState" />
    <label for="fastforward">⏩</label>
    <input name="time" type="radio" id="fastforward2" value="2" checked="@(gameSpeed == 2)" @onchange="@changeState" />
    <label for="fastforward2">4⏩</label>
    <input name="time" type="radio" id="fastforward3" value="3" checked="@(gameSpeed == 3)" @onchange="@changeState" />
    <label for="fastforward3">8⏩</label>
    <input name="time" type="radio" id="fastforward4" value="4" checked="@(gameSpeed == 4)" @onchange="@changeState" />
    <label for="fastforward4">16⏩</label>
    <input name="time" type="radio" id="fastforward5" value="5" checked="@(gameSpeed == 5)" @onchange="@changeState" />
    <label for="fastforward5">32⏩</label>
</fieldset>
<div>
    <span>@progress % @progressError</span>
    <progress style="position:absolute; right:30%;top:30%" value="@((double)progress)"></progress>
</div>