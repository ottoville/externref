<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>7.3</LangVersion>
    <RazorLangVersion>3.0</RazorLangVersion>
    <PowerShellExe Condition=" '$(PowerShellExe)'=='' ">
      %WINDIR%\System32\WindowsPowerShell\v1.0\powershell.exe
    </PowerShellExe>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="EdgeDriverTest1\**" />
    <Compile Remove="EdgeDriverTest2\**" />
    <Compile Remove="EdgeDriverTest3\**" />
    <Compile Remove="src\**" />
    <Compile Remove="UnitTestProject1\**" />
    <Compile Remove="wwwroot\js\**" />
    <Content Remove="EdgeDriverTest1\**" />
    <Content Remove="EdgeDriverTest2\**" />
    <Content Remove="EdgeDriverTest3\**" />
    <Content Remove="src\**" />
    <Content Remove="UnitTestProject1\**" />
    <Content Remove="wwwroot\js\**" />
    <EmbeddedResource Remove="EdgeDriverTest1\**" />
    <EmbeddedResource Remove="EdgeDriverTest2\**" />
    <EmbeddedResource Remove="EdgeDriverTest3\**" />
    <EmbeddedResource Remove="src\**" />
    <EmbeddedResource Remove="UnitTestProject1\**" />
    <EmbeddedResource Remove="wwwroot\js\**" />
    <None Remove="EdgeDriverTest1\**" />
    <None Remove="EdgeDriverTest2\**" />
    <None Remove="EdgeDriverTest3\**" />
    <None Remove="src\**" />
    <None Remove="UnitTestProject1\**" />
    <None Remove="wwwroot\js\**" />
    <TypeScriptCompile Remove="EdgeDriverTest1\**" />
    <TypeScriptCompile Remove="EdgeDriverTest2\**" />
    <TypeScriptCompile Remove="EdgeDriverTest3\**" />
    <TypeScriptCompile Remove="src\**" />
    <TypeScriptCompile Remove="UnitTestProject1\**" />
    <TypeScriptCompile Remove="wwwroot\js\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="shaders\grass2.frag" />
    <None Remove="shaders\grass2.vert" />
    <None Remove="shaders\ground.frag" />
    <None Remove="shaders\ground.vert" />
    <None Remove="shaders\sun.frag" />
    <None Remove="shaders\sun.vert" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="buildShaders.js" />
    <Content Include="shaders\grass2.frag">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="shaders\grass2.vert">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="shaders\ground.frag">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="shaders\ground.vert">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="shaders\sun.frag">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="shaders\sun.vert">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Blazor" Version="3.0.0-preview9.19424.4" />
    <PackageReference Include="Microsoft.AspNetCore.Blazor.Build" Version="3.0.0-preview9.19424.4" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Blazor.HttpClient" Version="3.0.0-preview9.19424.4" />
    <PackageReference Include="Microsoft.AspNetCore.Blazor.DevServer" Version="3.0.0-preview9.19424.4" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="3.0.0-preview9.19424.4" />
    <PackageReference Include="Microsoft.TypeScript.MSBuild" Version="3.6.3">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Tools\" />
  </ItemGroup>

  <ProjectExtensions><VisualStudio><UserProperties /></VisualStudio></ProjectExtensions>

  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="node .\buildShaders.js" />
  </Target>

</Project>
