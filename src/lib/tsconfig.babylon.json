{
  "include": [
    "./babylon/**/*.ts",
    "./babylon/**/*.d.ts",
    "./material/**/*.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "types": [],
    "baseUrl": "./",
    "rootDir": "./",
    "moduleResolution": "node",
    "module": "esNext",
    "target": "es5",
    "experimentalDecorators": true,
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "lib": [
      "es5",
      "dom",
      "es2015.promise",
      "es2015.collection",
      "es2015.iterable",
      "esnext"
    ],
    "outDir": "../../wwwroot/js/lib",
    "paths": {
      "babylonjs/*": [
        "./babylon/"
      ]
    }
  }
}