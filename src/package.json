{
  "name": "terrasim",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "serve": "npm run publish && http-server ..\\bin\\Debug\\netstandard2.0\\publish\\BlazorApp1\\dist\\ -S -o",
    "buildRust": "cargo rustc --lib --manifest-path ./Cargo.toml --target wasm32-unknown-unknown --target-dir ../wwwroot/js/engine -- -C target-feature=+simd128",
    "buildRust-prod": "cargo rustc --release --lib --manifest-path ./Cargo.toml --target wasm32-unknown-unknown --target-dir ../wwwroot/js/engine -- -C target-feature=+simd128",
    "buildRust2": "rustc --edition=2018 -o ../wwwroot/js/engine/engine.wasm --crate-type=cdylib -C target-feature=+simd128,+reference-types --target=wasm32-unknown-unknown ./engine/src/lib.rs",
    "buildRust-testem": "cargo rustc --lib --manifest-path ./Cargo.toml --target wasm32-unknown-unknown --target-dir ./test-build/js/engine -- -C target-feature=+simd128",
    "buildWasm": "wat2wasm.exe collider\\collider.wat --debug-names -o ..\\wwwroot\\collider\\colliderO.wasm",
    "buildWasmSimd": "pwsh -Command ./wat2wasm collider/colliderSIMD2.wat --debug-names -o ../wwwroot/collider/colliderSimdO.wasm",
    "buildWasmSimd-testem": "wat2wasm.exe collider\\colliderSIMD2.wat --debug-names -o .\\test-build\\collider\\colliderSimdO.wasm ",
    "buildWasmSimd-prod": "wat2wasm.exe collider\\colliderSIMD2.wat -o ..\\wwwroot\\collider\\colliderSimd.wasm && wasm-opt.exe ..\\wwwroot\\collider\\colliderSimd.wasm -o ..\\wwwroot\\collider\\colliderSimdO.wasm -O3 --enable-simd --always-inline-max-function-size 200",
    "build": "npm run buildRust && npm run buildShaders && tsc -b  && npm run buildWasmSimd",
    "build-prod": "npm run buildRust-prod && npm run buildShaders && tsc -b  && npm run buildWasmSimd",
    "build-test": "node ../findTests.js && tsc -b  tsconfig.testem.json && npm run buildRust-testem && npm run buildWasmSimd-testem",
    "buildShaders": "node ../buildShaders.js",
    "publish": "tsc && dotnet build ../BlazorApp1.csproj && dotnet publish ../BlazorApp1.csproj",
    "testWasm": "node --experimental-wasi-unstable-preview1 --experimental-wasm-simd collider/test/test.mjs",
    "testem-ci": "node ../findTests.js && tsc -b  tsconfig.testem.json && npm run buildRust-testem && npm run buildWasmSimd-testem && testem --file ./test-build/testem_config_ci.json",
    "eslint": "eslint --quiet ./*/**.ts .",
    "swa": "swa start ../wwwroot/ --ssl --ssl-cert=\"../server.crt\" --ssl-key=\"../server.key\"",
    "test-wasm": "node --experimental-wasi-unstable-preview1 --experimental-wasm-simd collider/test/test.mjs",

    "test": "node --inspect --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --silent=false",
    "test-integration": "start npm run swa && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --silent=false --config=jest.integration.config.js",
    "testem": "npm run build-test && testem --file testem_config.json"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@webgpu/types": "0.1.20",
    "typescript": "4.7.4",
    "wasm-opt": "1.3.0"
  },
  "devDependencies": {
    "@azure/static-web-apps-cli": "^1.0.1",
    "@types/node": "^16.9.2",
    "@typescript-eslint/eslint-plugin": "5.26.0",
    "@typescript-eslint/parser": "5.26.0",
    "eslint": "8.16.0",
    "eslint-plugin-promise": "6.0.0",
    "jest": "28.1.1",
    "puppeteer-core": "14.3",
    "ts-jest": "28.0.5"
  }
}
