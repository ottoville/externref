{
  "name": "terrasim",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "serve": "npm run publish && http-server ..\\bin\\Debug\\netstandard2.0\\publish\\BlazorApp1\\dist\\ -S -o",
    "buildRust": "wasm-pack build engine --target web --out-dir ../../wwwroot/js/engine -- -Z build-std=panic_abort,std",
    "buildWasm": "wat2wasm.exe collider\\colliderSIMD2.wat --debug-names -o ..\\wwwroot\\collider\\colliderO.wasm --enable-simd",
    "buildWasm-prod": "wat2wasm.exe collider\\colliderSIMD2.wat -o ..\\wwwroot\\collider\\collider.wasm --enable-simd && wasm-opt.exe ..\\wwwroot\\collider\\collider.wasm -o ..\\wwwroot\\collider\\colliderO.wasm -O3 --enable-simd --always-inline-max-function-size 200",
    "buildWasmSIMD": "wat2wasm.exe collider\\colliderSIMD.wat -o ..\\wwwroot\\collider\\colliderSIMD.wasm --enable-simd && wasm-opt.exe ..\\wwwroot\\collider\\colliderSIMD.wasm -o ..\\wwwroot\\collider\\colliderSIMDO.wasm -O3 --enable-simd --always-inline-max-function-size 100",
    "build": "npm run buildRust && tsc -b  && npm run buildWasm",
    "build-prod": "npm run buildRust && tsc -b  && npm run buildWasm-prod",
    "publish": "tsc && dotnet build ../BlazorApp1.csproj && dotnet publish ../BlazorApp1.csproj",
    "test": "node --experimental-wasi-unstable-preview1 --experimental-wasm-simd collider/test/test.mjs"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/facebook-js-sdk": "^3.3.0",
    "@webgpu/types": "0.1.6",
    "esm": "^3.2.25",
    "testem": "^3.4.3",
    "wasm-opt": "^1.1.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^4.22.0",
    "@typescript-eslint/parser": "^4.22.0",
    "eslint": "^7.24.0",
    "typescript": "^4.4.2"
  }
}
