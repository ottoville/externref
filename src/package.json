{
  "name": "terrasim",
  "version": "1.0.0",
  "description": "",
  "main": "game.js",
  "scripts": {
    "buildRust": "cargo rustc --features webgpu           --lib --manifest-path ./Cargo.toml --target wasm32-unknown-unknown --target-dir ../rust -- -C target-feature=+simd128 && pwsh -Command cp ../rust/wasm32-unknown-unknown/debug/engine.wasm ../wwwroot/engine.wasm",
    "buildRust-prod": "cargo rustc --features webgpu --release --lib --manifest-path ./Cargo.toml --target wasm32-unknown-unknown --target-dir ../rust -- -C target-feature=+simd128 && pwsh -Command cp ../rust/wasm32-unknown-unknown/release/engine.wasm ../wwwroot/engine.wasm",
    "buildRust-test": "cargo rustc --lib --manifest-path ./Cargo.toml --target wasm32-unknown-unknown --target-dir ../node -- -C target-feature=+simd128",
    "buildWasm": "wat2wasm.exe collider\\collider.wat --debug-names -o ..\\wwwroot\\collider\\colliderO.wasm",
    "buildWasmSimd": "pwsh -Command ./wat2wasm collider/colliderSIMD2.wat --debug-names -o ../wwwroot/collider/colliderSimdO.wasm",
    "buildWasmSimd-prod": "pwsh -Command \"./wat2wasm collider/colliderSIMD2.wat -o ../wwwroot/collider/colliderSimd.wasm && ../wasm-opt/wasm-opt ../wwwroot/collider/colliderSimd.wasm -o ../wwwroot/collider/colliderSimdO.wasm -O3 --enable-simd --always-inline-max-function-size 200\"",
    "build": "npm run buildRust && tsc -b  && npm run buildWasmSimd && npm run build-webpack-debug",
    "build-prod": "npm run buildRust-prod && tsc -b  && npm run buildWasmSimd-prod && npm run build-webpack-prod",
    "build-webpack-debug": "webpack --config webpack.config.canvas.debug.mjs && webpack --config webpack.config.devtools.debug.mjs",
    "build-webpack-prod": "webpack --config webpack.config.canvas.mjs && webpack --config webpack.config.devtools.mjs",
    "eslint": "eslint --ext .ts,.tsx --quiet ./",
    "eslint-fix": "eslint --fix --ext .ts,.tsx --quiet ./",
    "test": "npm run test-unit && npm run test-integration && npm run test-wasm && npm run test-rust && npm run test-cypress",
    "test-cypress-dev": "npx cypress open --env host=https://localhost:4280 --browser chrome",
    "test-cypress": "npx cypress run --env host=https://localhost:4280 --headed --browser chrome",
    "test-cypress-ci": "npx cypress run -C ./cypress.ci.config.ts --env host=https://nice-bush-07e6f7d03.1.azurestaticapps.net/ --browser chrome",
    "test-unit": "npm run buildRust-test && node --inspect --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit --detectOpenHandles --runInBand --silent=false",
    "test-integration": "npm run buildRust && start npm run swa && node --experimental-vm-modules node_modules/jest/bin/jest.js  --forceExit --detectOpenHandles --runInBand --silent=false --config=jest.integration.config.js",
    "test-rust": "cargo test           --lib --manifest-path ./Cargo.toml",
    "test-wasm": "node --experimental-wasi-unstable-preview1 --experimental-wasm-simd collider/test/test.mjs",
    "test-duplicates": " jscpd --exitCode 1 --ignore \"./node_modules/**,./rapier,./target,./jest*,./tests/**,.eslintrc.js,*.config.ts,tsconfig.json,cypress,webgpu-ts/Tests\" ./",
    "clean": "pwsh -Command \"rm *.tsbuildinfo; rm -r ./node_modules;rm -r ../wwwroot/js\"; cargo clean --target-dir ../rust"
  },
  "author": "Otto-Ville Lamminpää",
  "license": "All rights reserved",
  "dependencies": {
    "@microsoft/applicationinsights-web": "3.1.2",
    "@types/node": "20.11.0",
    "@types/offscreencanvas": "2019.7.0",
    "@types/react": "18.2.70",
    "@types/react-dom": "18.2.22",
    "@webgpu/types": "0.1.40",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "@swc/core": "^1.6.5",
    "swc-loader": "0.2.6",
    "typescript": "5.5.2",
    "webpack": "5.92.1",
    "webpack-cli": "5.1.4"
  },
  "devDependencies": {
    "@azure/static-web-apps-cli": "1.1.9",
    "@frsource/cypress-plugin-visual-regression-diff": "3.3.10",
    "@typescript-eslint/eslint-plugin": "7.14.1",
    "@typescript-eslint/parser": "7.14.1",
    "cypress": "13.6.2",
    "eslint": "8.57.0",
    "eslint-import-resolver-typescript": "3.6.1",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-prettier": "5.1.3",
    "eslint-plugin-promise": "6.1.1",
    "eslint-plugin-require-extensions": "^0.1.3",
    "jest": "29.5.0",
    "jscpd": "3.5.10",
    "prettier": "3.2.5",
    "puppeteer-core": "20.5.0",
    "source-map-loader": "4.0.1",
    "ts-jest": "29.1.5"
  }
}
