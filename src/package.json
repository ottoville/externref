{
  "name": "terrasim",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "serve": "npm run publish && http-server ..\\bin\\Debug\\netstandard2.0\\publish\\BlazorApp1\\dist\\ -S -o",
    "buildRust": "cargo rustc --lib --manifest-path ./engine/Cargo.toml  --target wasm32-unknown-unknown --target-dir ../wwwroot/js/engine -Z build-std=panic_abort,std -- -C target-feature=+simd128,+multivalue",
    "buildRust2": "rustc --edition=2018 -o ../wwwroot/js/engine/engine.wasm --crate-type=cdylib -C target-feature=+simd128,+reference-types --target=wasm32-unknown-unknown ./engine/src/lib.rs",
    "buildRust-testem": "wasm-pack build engine --target web --out-dir ../test-build/js/engine -- -Z build-std=panic_abort,std",
    "buildRust-testem2": "rustc --edition=2018 -o ./test-build/js/engine/engine.wasm --crate-type=cdylib -C target-feature=+simd128,+reference-types --target=wasm32-unknown-unknown ./engine/src/lib.rs",
    "buildWasm": "wat2wasm.exe collider\\collider.wat --debug-names -o ..\\wwwroot\\collider\\colliderO.wasm",
    "buildWasmSimd": "pwsh -Command New-Item  ../wwwroot/collider/ -Force -ItemType \"directory\" && pwsh -Command ./wat2wasm collider/colliderSIMD2.wat --debug-names -o ../wwwroot/collider/colliderSimdO.wasm",
    "buildWasmSimd-testem": "wat2wasm.exe collider\\colliderSIMD2.wat --debug-names -o .\\test-build\\collider\\colliderSimdO.wasm ",
    "buildWasmSimd-prod": "wat2wasm.exe collider\\colliderSIMD2.wat -o ..\\wwwroot\\collider\\colliderSimd.wasm && wasm-opt.exe ..\\wwwroot\\collider\\colliderSimd.wasm -o ..\\wwwroot\\collider\\colliderSimdO.wasm -O3 --enable-simd --always-inline-max-function-size 200",
    "build": "pwsh -Command New-Item  ../wwwroot/js/engine -Force -ItemType \"directory\" && npm run buildRust2 && npm run buildShaders && tsc -b  && npm run buildWasmSimd",
    "build-test": "node ../findTests.js && tsc --project tsconfig.testem.json && npm run buildRust-testem2 && npm run buildWasmSimd-testem",
    "buildShaders": "node ../buildShaders.js",
    "build-prod": "npm run buildRust && tsc -b  && npm run buildWasmSimd-prod",
    "publish": "tsc && dotnet build ../BlazorApp1.csproj && dotnet publish ../BlazorApp1.csproj",
    "test": "node --experimental-wasi-unstable-preview1 --experimental-wasm-simd collider/test/test.mjs",
    "testem": "npm run build-test && npm run testem --prefix ./test-build",
    "testem-ci": "node ../findTests.js && tsc --project tsconfig.testem.json && npm run buildRust-testem2 && npm run buildWasmSimd-testem && npm run testem-ci --prefix ./test-build",
    "eslint": "eslint --quiet ./*/**.ts ."
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/facebook-js-sdk": "^3.3.0",
    "@webgpu/types": "0.1.13",
    "esm": "^3.2.25",
    "wasm-opt": "^1.1.1",
    "typescript": "4.5.5"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.1"
  }
}
