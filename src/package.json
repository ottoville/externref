{
  "name": "terrasim",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "serve": "npm run publish && http-server ..\\bin\\Debug\\netstandard2.0\\publish\\BlazorApp1\\dist\\ -S -o",
    "buildWasm": "wat2wasm.exe collider\\collider.wat -o ..\\wwwroot\\collider\\collider.wasm --enable-simd && wasm-opt.exe ..\\wwwroot\\collider\\collider.wasm -o ..\\wwwroot\\collider\\colliderO.wasm -O3 --enable-simd --always-inline-max-function-size 100",
    "buildWasmSIMD": "wat2wasm.exe collider\\colliderSIMD.wat -o ..\\wwwroot\\collider\\colliderSIMD.wasm --enable-simd && wasm-opt.exe ..\\wwwroot\\collider\\colliderSIMD.wasm -o ..\\wwwroot\\collider\\colliderSIMDO.wasm -O3 --enable-simd --always-inline-max-function-size 100",
    "build": "npm run buildWasm && npm run buildWasmSIMD",
    "publish": "tsc && dotnet build ../BlazorApp1.csproj && dotnet publish ../BlazorApp1.csproj",
    "test": "npm run buildWasm && node --experimental-wasi-unstable-preview1 --experimental-wasm-simd collider/test/test.mjs"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/facebook-js-sdk": "^3.3.0",
    "@webgpu/types": "0.0.35",
    "esm": "^3.2.25",
    "wasm-opt": "^1.1.1"
  },
  "devDependencies": {
    "typescript": "4.0.2"
  }
}
