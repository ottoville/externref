{
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports":true,
    "target": "ESNext",
    "module": "ESNext",
    "jsx": "react",
    "sourceMap": false,
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    "strict": true,
    "tsBuildInfoFile": "tsconfig.testbuild.tsbuildinfo",
    "incremental": true,
    "lib": [
      "dom",
      "esnext",
      "ES2017.SharedMemory",
      "DOM.Iterable"
    ],
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "typeRoots": ["./node_modules/@webgpu/"],
    "types": ["jest", "@webgpu/types"]
  },
  "exclude": [
    "workers",
    "lib",
    "service-worker.ts",
    "service-worker.published.ts",
    "jest.config.js",
    "package.json"
  ],
  
  "include": [ "tests.json", "**/*.ts", "**/*.tsx", "**/*.d.ts", "./rustwasm/*.js", "./node_modules/@webgpu/**/*", "./runTest.ts"],
}
