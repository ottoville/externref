{
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "composite": true,
    "outDir": "../wwwroot",
    "module": "esnext",
    "target": "esnext",
    "lib": ["esnext", "webworker"],
    "sourceMap": false,
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    //"strict": true,
    "tsBuildInfoFile": "tsconfig.serviceworkers.tsbuildinfo",
    "types": []
  },
  "exclude": ["node_modules"],
  "include": ["./service-worker.ts"]
}
