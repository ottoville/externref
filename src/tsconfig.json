{
  "compilerOptions": {
    "typeRoots": [ "./node_modules/@types", "./types", "js/declarations" ],
    "outDir": "../wwwroot/js",
    "declaration": true,
    "declarationDir": "../wwwroot/js/declarations",
    "target": "es6",
    "module": "es6",
    "lib": [
      "dom",
      "esnext"
    ],
    "types": [
      "babylonjs",
      "babylonjs-materials",
      "facebook-js-sdk",
      "mocha",
      "interfaces"
    ],
    "moduleResolution": "node"
  },
  "exclude": [
    "node_modules"
  ]
}