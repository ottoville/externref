{
  "compilerOptions": {
    "outDir": "../wwwroot/js",
    "target": "es6",
    "module": "es6",
    "lib": [
      "dom",
      "esnext"
    ],
    "types": [
      "babylonjs",
      "babylonjs-materials",
      "facebook-js-sdk"
    ],
    "moduleResolution": "node"
  },
  "exclude": [
    "node_modules",
    "workers"
  ],
  "references": [
    { "path": "./workers/tsconfig.json" }
  ]
}