{
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "outDir": "../wwwroot/js",
    "strictNullChecks": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "strictBuiltinIteratorReturn": true,
    "strict": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "jsx": "react-jsx",
    //"strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["dom", "esnext", "ES2017.SharedMemory", "DOM.Iterable"],
    "typeRoots": ["./node_modules/", "./node_modules/@types/"],
    "types": ["@webgpu/types", "offscreencanvas"],
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowJs": true,
    "incremental": true,
    "tsBuildInfoFile": "tsconfig.main.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "/js/engine/*": ["../wwwroot/js/engine/*"]
    },
    "allowSyntheticDefaultImports": true
  },
  "include": ["**/*.ts", "**/*.tsx", "./rustwasm/*.js", "game.ts"],
  "exclude": [
    "env.dev.ts",
    "node_modules",
    "jestWorker.ts",
    "workers",
    "service-worker.ts",
    "**/*.test.integration.ts",
    "**/*.test.ts",
    "cypress",
    "cypress.config.ts",
    "cypress.ci.config.ts"
  ],
  "references": [
    { "path": "./tsconfig.workers.json" },
    { "path": "./tsconfig.serviceworkers.json" }
  ]
}
