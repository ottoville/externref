{
  "compilerOptions": {
      "experimentalDecorators": true,
    "outDir": "../wwwroot/js",
   // "strictNullChecks": true,
   // "strictBindCallApply": true,
    //"strictFunctionTypes": true,
    //"strictPropertyInitialization": true,
    //"noImplicitAny": true,
    //"strict": true,
    "target": "esnext",
    "module": "es6",
    "lib": [
      "dom",
      "esnext"
    ],
    "types": [
      "facebook-js-sdk"
    ],
    "moduleResolution": "node",
    "allowJs": true,
    "incremental": true,
    "tsBuildInfoFile": "tsconfig.main.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "babylonjs/*": [
        "./lib/babylon/"
      ]
    }
  },
  "include": ["**/*.ts", "**/*.d.ts", "./rustwasm/*.js"],
  "exclude": [
    "node_modules",
    "workers"
  ],
  "references": [
    { "path": "./workers/tsconfig.json" }
  ]
}