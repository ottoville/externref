{
  "compilerOptions": {
    "outDir": "../wwwroot/js",
    //"strictNullChecks": true,
    "strictBindCallApply": true,
    //"strictPropertyInitialization": true,
    "target": "esnext",
    "module": "es6",
    "lib": [
      "dom",
      "esnext"
    ],
    "types": [
      "babylonjs",
      "babylonjs-materials",
      "facebook-js-sdk"
    ],
    "moduleResolution": "node",
    "allowJs": true
  },
  "include": ["**/*.ts", "**/*.d.ts", "./rustwasm/*.js"],
  "exclude": [
    "node_modules",
    "workers"
  ],
  "references": [
    { "path": "./workers/tsconfig.json" }
  ]
}