{
  "compilerOptions": {
    "experimentalDecorators": true,
    "outDir": "../wwwroot/js",
     "strictNullChecks": true,
     "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "strict": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": false,
    //"strict": true,
    "target": "esnext",
    "module": "ESNext",
    "lib": [
      "dom",
      "esnext"
    ],
    "typeRoots": [ "./node_modules/@types/", "./node_modules/@webgpu/" ],
    "types": [
      "facebook-js-sdk",
      "types"
    ],
    "moduleResolution": "node",
    "allowJs": true,
    "incremental": true,
    "tsBuildInfoFile": "tsconfig.main.tsbuildinfo",
    "baseUrl": "."
  },
  "include": [ "**/*.ts", "**/*.d.ts", "./rustwasm/*.js", "./node_modules/@webgpu/**/*" ],
  "exclude": [
    "node_modules",
    "workers",
    "lib"
  ],
  "references": [
    { "path": "./workers/tsconfig.json" }
  ]
}