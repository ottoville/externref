{
  "compilerOptions": {
    "declaration": false,
    "experimentalDecorators": true,
    "outDir": "../wwwroot/js",
    "strictNullChecks": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "strict": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "jsx": "react",
    "jsxFactory": "TerraUI.createElement",
    //"strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "lib": [
      "dom",
      "esnext",
      "ES2017.SharedMemory",
      "DOM.Iterable"
    ],
    "typeRoots": ["./node_modules/@webgpu/", "./node_modules/@types/"],
    "types": ["@webgpu/types", "offscreencanvas"],
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowJs": true,
    "incremental": true,
    "tsBuildInfoFile": "tsconfig.main.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "/js/engine/*": ["../wwwroot/js/engine/*"]
    },
    "allowSyntheticDefaultImports": true,
  },
  "include": ["**/*.ts", "**/*.tsx", "./rustwasm/*.js", "code.tsx" ],
  "exclude": [
    "node_modules",
    "jestWorker.ts",
    "workers",
    "lib",
    "service-worker.ts",
    "runTest.ts",
    "**/*.test.integration.ts",
    "**/*.test.ts",
    "**/*.tesX.ts",
    "tests.json"
  ],
  "references": [
    { "path": "./tsconfig.workers.json" },
    { "path": "./tsconfig.serviceworkers.json" },
  ]
}