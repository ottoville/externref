{
  "compilerOptions": {
    "experimentalDecorators": true,
    "outDir": "../wwwroot/js",
    "strictNullChecks": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "strict": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "jsx": "react",
    "jsxFactory": "TerraUI.createElement",
    //"strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "lib": [
      "dom",
      "esnext",
      "ES2017.SharedMemory"
    ],
    "typeRoots": [ "./node_modules/@types/", "./node_modules/@webgpu/" ],
    "types": [
      "facebook-js-sdk",
      "types"
    ],
    "moduleResolution": "node",
    "allowJs": true,
    "incremental": true,
    "tsBuildInfoFile": "tsconfig.main.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "/js/engine/*": ["../wwwroot/js/engine/*"],
    }
  },
  "include": [ "**/*.ts", "**/*.tsx", "**/*.d.ts", "./rustwasm/*.js", "./node_modules/@webgpu/**/*", "code.tsx" ],
  "exclude": [
    "node_modules",
    "workers",
    "lib"
  ],
  "references": [
    { "path": "./tsconfig.workers.json" },
    { "path": "./tsconfig.serviceworkers.json" }
  ]
}