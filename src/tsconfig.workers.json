{
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "composite": true,
    "outDir": "../wwwroot/js",
    "module": "esnext",
    "target": "ESNext",
    "lib": [ "esnext", "webworker" ],
    "sourceMap": false,
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    //"strict": true,
    "tsBuildInfoFile": "tsconfig.workers.tsbuildinfo",
    "types": []
  },
  "exclude": [
    "node_modules"
  ],
  "include": [
    "./workers/webworkers/*.ts",
  ]
}
