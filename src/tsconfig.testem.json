{
  "compilerOptions": {
    "allowSyntheticDefaultImports":true,
    "outDir": "./test-build/js",
    "target": "ESNext",
    "module": "ESNext",

    "jsx": "react",
    "jsxFactory": "TerraUI.createElement",
    "sourceMap": false,
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    //"strict": true,
    "tsBuildInfoFile": "tsconfig.testbuild.tsbuildinfo",
    "incremental": true,
    "typeRoots": [ "./node_modules/@types/", "./node_modules/@webgpu/", "./test-build/node_modules/@types/"],
    "types": ["types", "mocha"],
    "paths": {
      "/js/*": ["./*"],
      "/js/engine/*": ["./test-build/js/engine/*"],
    },
    "lib": [
      "dom",
      "esnext",
      "ES2017.SharedMemory",
      "DOM.Iterable"
    ],
    "resolveJsonModule": true,
    "moduleResolution": "node",
  },
  "exclude": [
    "node_modules",
    "workers",
    "lib",
    "service-worker.ts",
    "service-worker.published.ts",
  ],
  
  "include": [ "tests.json", "**/*.ts", "**/*.tsx", "**/*.d.ts", "./rustwasm/*.js", "./node_modules/@webgpu/**/*", "./runTest.ts"],

}
