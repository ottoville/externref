{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "type": "pwa-chrome",
            "request": "launch",
            "name": "Launch Chrome against localhost",
            "webRoot": "${workspaceFolder}",
            "runtimeExecutable": "canary",
            "runtimeArgs": [
                "--remote-debugging-port=9222",
                "--enable-features=SharedArrayBuffer"
            ],
            "url": "https://localhost:4280",
            "presentation": {
                "hidden": true
            },
            "preLaunchTask": "start-swa"
        },
        {
            "type": "msedge",
            "name": "Launch Microsoft Edge",
            "request": "launch",
            "runtimeExecutable": "stable",
            "runtimeArgs": [
                "--remote-debugging-port=9222",
                "--enable-features=SharedArrayBuffer"
            ],
            "url": "https://localhost:4280", // Provide your project's url to finish configuring
            "presentation": {
                "hidden": true
            },
            "preLaunchTask": "start-swa"
        },
        {
            "type": "pwa-msedge",
            "name": "Launch Microsoft Edge in headless mode",
            "request": "launch",
            "runtimeArgs": [
                "--headless",
                "--remote-debugging-port=9222"
            ],
            "url": "c:\\Users\\ottov\\.vscode\\extensions\\ms-edgedevtools.vscode-edge-devtools-1.4.7\\out\\startpage\\index.html", // Provide your project's url to finish configuring
            "presentation": {
                "hidden": true
            }
        },
        {
            "type": "vscode-edge-devtools.debug",
            "name": "Open Edge DevTools",
            "request": "attach",
            "url": "c:\\Users\\ottov\\.vscode\\extensions\\ms-edgedevtools.vscode-edge-devtools-1.4.7\\out\\startpage\\index.html", // Provide your project's url to finish configuring
            "presentation": {
                "hidden": true
            }
        },
        {
            "name": "Debug Jest Tests",
            "type": "node",
            "runtimeExecutable": "npm",
            "request": "launch",
            "runtimeArgs": [
              "run",
              "test",
              "--prefix=./src",
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "port": 9229
          }
    ],
    "compounds": [
        {
            "name": "Launch chrome",
            "configurations": [
                "Launch Chrome against localhost"
            ]
        },
        {
            "name": "Launch Edge Headless and attach DevTools",
            "configurations": [
                "Launch Microsoft Edge in headless mode",
                "Open Edge DevTools"
            ]
        },
        {
            "name": "Launch Edge and attach DevTools",
            "configurations": [
                "Launch Microsoft Edge",
                "Open Edge DevTools"
            ]
        }
    ]
}