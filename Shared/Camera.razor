@inject IJSRuntime JSRuntime;
@code {
    Boolean debugCameraActivated = false;
}
    <button class="w3-bar-item w3-button" @onclick="@(() => {
                            debugCameraActivated = !debugCameraActivated;
                            JSRuntime.InvokeAsync<bool>("scene.tools.CameraTAB.activateDebugCamera",debugCameraActivated);
                        })">Debug camera</button>

