#version 450
float minX=-5000.0;
float minZ=-5000.0;

float maxX=5000.0;
float maxZ=5000.0;

float subdivisionsX = 250.0;
float subdivisionsY = 250.0;

float width = 10000.0;
float height = 10000.0;

layout(set = 0, binding = 0) uniform Terra {
   vec2 mouse;
   float radiusPow;
} terra;

layout(std430, set = 1, binding = 1) readonly buffer Positions {
    float positions[];
} terrain;

float DistanceSquared( vec2 value1, vec2 value2) {
    float x = value1.x - value2.x;
    float y = value1.y - value2.y;
    return (x * x) + (y * y);
}

  void main() {
    vec2 position;
    position.x = terrain.positions[gl_GlobalInvocationID.x * 3];
    position.y = terrain.positions[gl_GlobalInvocationID.x * 3 + 2];
    float distance = DistanceSquared(position, terra.mouse);
    if (distance < terra.radiusPow) {
        
        _selectedVertices.push({
            col: 250 / (10000 / (5000 + position.x)) | 0,
            row: 250 / (10000 / (5000 - position.y)) | 0,
            vertice: index,
            distance: Math.sqrt(distance)
        });
    }

  }