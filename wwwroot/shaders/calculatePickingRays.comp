#version 450
struct BoundableStruct {
  mat4 worldPosition;
  vec4 delta;
  vec4 customData;
  int[40] padding;
};
layout(std430, set = 0, binding = 0) readonly buffer Camera {
    mat4 projection;
    mat4 view;
    vec3 nearScreenSource;
    vec3 farScreenSource;
} camera;
layout(std430, set = 0, binding = 1) readonly buffer Boundables {
    BoundableStruct data[10];
} boundables;
layout(std430, set = 0, binding = 2) buffer Rays {
    float numbers[];
} rays;
const float epsilon = 0.00001;


vec4 UnprojectFromInvertedMatrix(vec3 source, mat4 matrix) {
    vec4 result = vec4(source,1.0) * matrix;
    //    var num = nearScreenSource.x * worldViewProjection[3] + nearScreenSource.y * worldViewProjection[7] + nearScreenSource.z * worldViewProjection[11] + worldViewProjection[15];
    float num = source.x * matrix[0].z + source.y * matrix[1].z + source.z * matrix[2].z + matrix[3].z;
    //if (Scalar.WithinEpsilon(num, 1.0)) {
    //    result.scaleInPlace(1.0 / num);
    //}
    if(num - 1.0 < epsilon) {
        result*=(1/num);
     }
    return result;
 }

  void main() {
    mat4 worldPosition=boundables.data[gl_GlobalInvocationID.x].worldPosition;

    //TODO precalculate camera.view*camera.projection
    mat4 worldViewProjection=inverse(worldPosition*camera.view*camera.projection);
    vec4 nearVec = UnprojectFromInvertedMatrix(camera.nearScreenSource, worldViewProjection);
    vec4 farVec = UnprojectFromInvertedMatrix(camera.farScreenSource, worldViewProjection);

    rays.numbers[gl_GlobalInvocationID.x*6]=nearVec.x;
    rays.numbers[gl_GlobalInvocationID.x*6+1]=nearVec.y;
    rays.numbers[gl_GlobalInvocationID.x*6+2]=nearVec.z;

    const vec3 direction = normalize(farVec.xyz-nearVec.xyz);

    rays.numbers[gl_GlobalInvocationID.x*6+3]=direction.x;
    rays.numbers[gl_GlobalInvocationID.x*6+4]=direction.y;
    rays.numbers[gl_GlobalInvocationID.x*6+5]=direction.z;
  }