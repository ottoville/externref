#version 450
float minX=-5000.0;
float minZ=-5000.0;

float maxX=5000.0;
float maxZ=5000.0;

float subdivisionsX = 250.0;
float subdivisionsY = 250.0;

float width = 10000.0;
float height = 10000.0;

  layout(std430, set = 0, binding = 0) readonly buffer Slopes {
      int numbers[];
  } slopes;

  layout(std430, set = 0, binding = 1) readonly buffer Facet1 {
      float numbers[];
  } facet1;

  layout(std430, set = 0, binding = 2) readonly buffer Facet2 {
      float numbers[];
  } facet2;

  layout(std430, set = 1, binding = 0) buffer ResultMatrix {
      vec2 size;
      int numbers[];
  } resultMatrix;

  void main() {
    resultMatrix.size = vec2(5120, 5120);

    int cx=int(gl_GlobalInvocationID.x*1.95 - 5000);
    int cz=int(gl_GlobalInvocationID.y*1.95 - 5000);

    int col = int(floor((cx+maxX) * subdivisionsX / width));
    int row= int(floor(-(cz+maxZ)*subdivisionsY / height + subdivisionsY));
    int slope = slopes.numbers[row*250 + col];
    vec4 facet;
    if(cz < -1 * cx + slope) {
        facet=vec4(facet1.numbers[(row * 250 + col)*4], facet1.numbers[(row * 250 + col)*4+1], facet1.numbers[(row * 250 + col)*4+2], facet1.numbers[(row * 250 + col)*4+3]);
    } else {
        facet=vec4(facet2.numbers[(row * 250 + col)*4], facet2.numbers[(row * 250 + col)*4+1], facet2.numbers[(row * 250 + col)*4+2], facet2.numbers[(row * 250 + col)*4+3]);
    }

    float y = -(facet.x * cx + facet.z * cz + facet.w) / facet.y;
    if( y>3 ) {
        
        resultMatrix.numbers[gl_GlobalInvocationID.y*5120 + gl_GlobalInvocationID.x]=-16711936; //Int32 represation of uint8 0, 255, 0, 255
     } else
     resultMatrix.numbers[gl_GlobalInvocationID.y*5120 + gl_GlobalInvocationID.x]=-16711681; //Int32 represation of uint8 255, 255, 0, 255
  }