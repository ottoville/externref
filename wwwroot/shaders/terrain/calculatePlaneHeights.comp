#version 450
precision highp float;
uint subdivisions = 250;
uint facetSize= 250 * 250 * 4;


uint stride=8;
layout(std430, set = 0, binding = 0) readonly buffer Plane {
    float positionsAndUvsAndNormals[];
} plane;
layout(std430, set = 1, binding = 0) buffer Slopes {
    int numbers[];
} slopes;

//layout(std430, set = 1, binding = 1) buffer Facet1 {
 //   float numbers[];
//} facet1;

layout(std430, set = 1, binding = 1) buffer Facet12 {
    float numbers[];
} facet12;


int cd = -1;
void main() {
    uint idx1 = (gl_GlobalInvocationID.x + 1 + (gl_GlobalInvocationID.y + 1) * (subdivisions + 1));
    uint idx2 = (gl_GlobalInvocationID.x + 1 + gl_GlobalInvocationID.y * (subdivisions + 1));
    uint idx3 = (gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * (subdivisions + 1));
    uint idx4 = (gl_GlobalInvocationID.x + (gl_GlobalInvocationID.y + 1) * (subdivisions + 1));


    //calculateHeightSquad(row, col);
    uint i = gl_GlobalInvocationID.y * stride;
    uint j = gl_GlobalInvocationID.x * (subdivisions + 1) * stride;
    uint k = (gl_GlobalInvocationID.x + 1) * (subdivisions + 1) * stride;


    vec3 v1arr = vec3 (
        plane.positionsAndUvsAndNormals[j + i],
        plane.positionsAndUvsAndNormals[j + i + 1],
        plane.positionsAndUvsAndNormals[j + i + 2]
    );
    vec3 v2arr = vec3 (
        plane.positionsAndUvsAndNormals[j + i + stride],
        plane.positionsAndUvsAndNormals[j + i + + stride +1],
        plane.positionsAndUvsAndNormals[j + i + stride + 2]
    );

    vec3 v1v3 = vec3(
        plane.positionsAndUvsAndNormals[k + i + 0],
        plane.positionsAndUvsAndNormals[k + i + 1],
        plane.positionsAndUvsAndNormals[k + i + 2]
    ) - v1arr;
    vec3 v1v4 = vec3(
        plane.positionsAndUvsAndNormals[k + i + stride],
        plane.positionsAndUvsAndNormals[k + i + stride +1],
        plane.positionsAndUvsAndNormals[k + i + stride +2]
    ) - v1arr;

    //   cd = (terrainPositions[k + i + 2] - v1arr[2]) / (terrainPositions[k + i + 3] - v1arr[0]);

    int h = int(v1arr.z - float(cd) * v1arr.x);             // v1 belongs to the slope

    // facet equations :
    // we compute each facet normal vector
    // the equation of the facet plane is : norm.x * x + norm.y * y + norm.z * z + d = 0
    // we compute the value d by applying the equation to v1 which belongs to the plane
    // then we store the facet equation in a Vector4

    vec3 v1v2 = v2arr - v1arr;
    vec3 norm1 = normalize(cross(v1v4, v1v3));

    vec3 norm2 = normalize(cross(v1v2, v1v4));


    float d1= dot(norm1,v1arr)*-1.0;
    float d2 = dot(norm2,v2arr)*-1.0;

    slopes.numbers[gl_GlobalInvocationID.x * subdivisions + gl_GlobalInvocationID.y] = h;

    facet12.numbers[(gl_GlobalInvocationID.x * subdivisions +  gl_GlobalInvocationID.y) * 4]= norm1.x;
    facet12.numbers[(gl_GlobalInvocationID.x * subdivisions +  gl_GlobalInvocationID.y) * 4 +1]= norm1.y;
    facet12.numbers[(gl_GlobalInvocationID.x * subdivisions +  gl_GlobalInvocationID.y) * 4 +2]= norm1.z;
    facet12.numbers[(gl_GlobalInvocationID.x * subdivisions +  gl_GlobalInvocationID.y) * 4 +3]= d1;

    facet12.numbers[facetSize +  ((gl_GlobalInvocationID.x * subdivisions +  gl_GlobalInvocationID.y) * 4)]= norm2.x;
    facet12.numbers[facetSize + ((gl_GlobalInvocationID.x * subdivisions +  gl_GlobalInvocationID.y) * 4 +1)]= norm2.y;
    facet12.numbers[facetSize + ((gl_GlobalInvocationID.x * subdivisions +  gl_GlobalInvocationID.y) * 4 +2)]= norm2.z;
    facet12.numbers[facetSize + ((gl_GlobalInvocationID.x * subdivisions +  gl_GlobalInvocationID.y) * 4 +3)]= d2;

 }