#version 450
precision highp float;

vec3 filt = vec3(0.3, 0.59, 0.11);

layout(std430, set = 0, binding = 0) readonly buffer Image {
    float width;
    float height;
    uint bufferWidth;
    uint bufferHeight;
    uint subdivisions;
    int minHeight;
    int maxHeight;
    int maxX;
    int maxZ;
    float vertices[];
} image;

uint iterations=image.subdivisions+1;

layout(std430, set = 0, binding = 1) buffer PositionsAndUvs {
    float numbers[];
} positionsAndUvs;

layout(std430, set = 0, binding = 2) buffer Position {
    float numbers[];
} positions;


  void main() {
      ivec3 position = ivec3(
          image.vertices[gl_GlobalInvocationID.y * iterations * 3 + gl_GlobalInvocationID.x*3],
          image.vertices[gl_GlobalInvocationID.y * iterations * 3 + gl_GlobalInvocationID.x*3 +1],
          image.vertices[gl_GlobalInvocationID.y * iterations * 3 + gl_GlobalInvocationID.x*3 +2]
      );

    positionsAndUvs.numbers[ gl_GlobalInvocationID.y*iterations*5 + gl_GlobalInvocationID.x*5]=position.x;
    positionsAndUvs.numbers[gl_GlobalInvocationID.y*iterations*5 + gl_GlobalInvocationID.x*5+1]=position.y;
    positionsAndUvs.numbers[gl_GlobalInvocationID.y*iterations*5 + gl_GlobalInvocationID.x*5+2]=position.z;

    positions.numbers[ gl_GlobalInvocationID.y*iterations*3 + gl_GlobalInvocationID.x*3]=position.x;
    positions.numbers[gl_GlobalInvocationID.y*iterations*3 + gl_GlobalInvocationID.x*3+1]=position.y;
    positions.numbers[gl_GlobalInvocationID.y*iterations*3 + gl_GlobalInvocationID.x*3+2]=position.z;


    positionsAndUvs.numbers[gl_GlobalInvocationID.y*iterations*5 + gl_GlobalInvocationID.x*5+3] = (position.x+image.maxX) / image.width;
    positionsAndUvs.numbers[gl_GlobalInvocationID.y*iterations*5 + gl_GlobalInvocationID.x*5+4] = (position.z+image.maxZ) / image.height;

  }