#version 450
float minX=-5000.0;
float minZ=-5000.0;

float maxX=5000.0;
float maxZ=5000.0;

int subdivisions = 250;
int bufferWidth=250;
int bufferHeight=250;
float width = 10000.0;
float height = 10000.0;

int minHeight=-2;
int maxHeight=255;

vec3 filt = vec3(0.3, 0.59, 0.11);

layout(std430, set = 0, binding = 0) readonly buffer Image {
    uint numbers[];
} image;

uint positionoffset=(250+1)*(250+1)*3;

layout(std430, set = 0, binding = 1) buffer PositionsAndUvs {
    float numbers[];
} positionsAndUvs;

  void main() {
      vec3 position = vec3((gl_GlobalInvocationID.x * width) / subdivisions - (width / 2.0),
      0,
      ((subdivisions - gl_GlobalInvocationID.y) * height) / subdivisions - (height / 2.0));

    ivec2 heightmap=ivec2(
        int(((position.x + width / 2) / width) * (bufferWidth - 1)),
         int((1.0 - (position.z + height / 2) / height) * (bufferHeight - 1))
    );
    int pos = (heightmap.x + heightmap.y * bufferWidth);

   uint pixel= image.numbers[pos];
    vec3 normalized= vec3(pixel & 0xff, (pixel >> 8) & 0xff, (pixel >> 16) & 0xff) / 255; // https://stackoverflow.com/questions/56210515/split-a-32-bit-integer-into-4-8-bit-integers

    float gradient = normalized.r * filt.x + normalized.g * filt.y + normalized.b * filt.z;

    position.y = minHeight + (maxHeight - minHeight) * gradient;



    positionsAndUvs.numbers[ gl_GlobalInvocationID.y*(250+1)*3 + gl_GlobalInvocationID.x*3]=position.x;
    positionsAndUvs.numbers[gl_GlobalInvocationID.y*(250+1)*3 + gl_GlobalInvocationID.x*3+1]=position.y;
    positionsAndUvs.numbers[gl_GlobalInvocationID.y*(250+1)*3 + gl_GlobalInvocationID.x*3+2]=position.z;

    positionsAndUvs.numbers[positionoffset + (gl_GlobalInvocationID.y*(250+1)*2 + gl_GlobalInvocationID.x*2)] = gl_GlobalInvocationID.x / subdivisions;
    positionsAndUvs.numbers[positionoffset + (gl_GlobalInvocationID.y*(250+1)*2 + gl_GlobalInvocationID.x*2+1)] = 1.0 - gl_GlobalInvocationID.y / subdivisions;
  }