#version 450
precision highp float;

float minX=-5000.0;
float minZ=-5000.0;

float maxX=5000.0;
float maxZ=5000.0;

vec3 filt = vec3(0.3, 0.59, 0.11);

layout(std430, set = 0, binding = 0) readonly buffer Image {
    float width;
    float height;
    uint bufferWidth;
    uint bufferHeight;
    uint subdivisions;
    int minHeight;
    int maxHeight;
    uint pixels[];
} image;

uint iterations=image.subdivisions+1;

layout(std430, set = 0, binding = 1) buffer PositionsAndUvs {
    float numbers[];
} positionsAndUvs;

  void main() {
      vec3 position = vec3((gl_GlobalInvocationID.x * image.width) / image.subdivisions - (image.width / 2.0),
      0,
      ((image.subdivisions - gl_GlobalInvocationID.y) * image.height) / image.subdivisions - (image.height / 2.0));

    ivec2 heightmap=ivec2(
        int(((position.x + image.width / 2) / image.width) * (image.bufferWidth - 1)),
         int((1.0 - (position.z + image.height / 2) / image.height) * (image.bufferHeight - 1))
    );
    uint pos = (heightmap.x + heightmap.y * image.bufferWidth);

    uint pixel= image.pixels[pos];
    vec3 normalized= (vec3(uvec3(pixel, pixel, pixel) >> uvec3(0,8,16) & 0xff)) / 255;


    vec3 filtered= normalized * filt;
    float gradient = filtered.r+filtered.g+filtered.b;

    position.y = image.minHeight + ( image.maxHeight -  image.minHeight) * gradient;



    positionsAndUvs.numbers[ gl_GlobalInvocationID.y*iterations*5 + gl_GlobalInvocationID.x*5]=position.x;
    positionsAndUvs.numbers[gl_GlobalInvocationID.y*iterations*5 + gl_GlobalInvocationID.x*5+1]=position.y;
    positionsAndUvs.numbers[gl_GlobalInvocationID.y*iterations*5 + gl_GlobalInvocationID.x*5+2]=position.z;

    


    positionsAndUvs.numbers[gl_GlobalInvocationID.y*iterations*5 + gl_GlobalInvocationID.x*5+3] = (position.x+maxX) / image.width;
    positionsAndUvs.numbers[gl_GlobalInvocationID.y*iterations*5 + gl_GlobalInvocationID.x*5+4] = (position.z+maxZ) / image.height;

    //positionsAndUvs.numbers[positionoffset + (gl_GlobalInvocationID.y*iterations*2 + gl_GlobalInvocationID.x*2)] = gl_GlobalInvocationID.x / float(image.subdivisions);
    //positionsAndUvs.numbers[positionoffset + (gl_GlobalInvocationID.y*iterations*2 + gl_GlobalInvocationID.x*2+1)] = 1.0 - gl_GlobalInvocationID.y / float(image.subdivisions);
  }