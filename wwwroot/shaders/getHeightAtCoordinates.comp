#version 450
float minX=-5000.0;
float minZ=-5000.0;

float maxX=5000.0;
float maxZ=5000.0;

float subdivisionsX = 250.0;
float subdivisionsY = 250.0;

float width = 10000.0;
float height = 10000.0;

layout(std430, set = 0, binding = 0) readonly buffer Positions {
    float numbers[];
} positions;

layout(std430, set = 0, binding = 1) readonly buffer Slopes {
    int numbers[];
} slopes;

layout(std430, set = 0, binding = 2) readonly buffer Facet1 {
    float numbers[];
} facet1;

layout(std430, set = 0, binding = 3) readonly buffer Facet2 {
    float numbers[];
} facet2;

layout(std430, set = 0, binding = 4) buffer PositionAndRotate {
    float numbers[];
} positionAndRotate;

layout(std430, set = 0, binding = 5) buffer Shapes {
    float numbers[];
} shapes;

