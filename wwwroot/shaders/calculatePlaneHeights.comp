#version 450
int subdivisions = 250;

layout(std430, set = 0, binding = 0) readonly buffer Plane {
    float positionsAndUvs[];
} plane;
layout(std430, set = 1, binding = 0) buffer Slopes {
    int numbers[];
} slopes;

layout(std430, set = 1, binding = 1) buffer Facet1 {
    float numbers[];
} facet1;

layout(std430, set = 1, binding = 2) buffer Facet2 {
    float numbers[];
} facet2;


int cd = -1;
void main() {
    uint idx1 = (gl_GlobalInvocationID.x + 1 + (gl_GlobalInvocationID.y + 1) * (subdivisions + 1));
    uint idx2 = (gl_GlobalInvocationID.x + 1 + gl_GlobalInvocationID.y * (subdivisions + 1));
    uint idx3 = (gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * (subdivisions + 1));
    uint idx4 = (gl_GlobalInvocationID.x + (gl_GlobalInvocationID.y + 1) * (subdivisions + 1));


    //calculateHeightSquad(row, col);
    uint i = gl_GlobalInvocationID.y * 5;
    uint j = gl_GlobalInvocationID.x * (subdivisions + 1) * 5;
    uint k = (gl_GlobalInvocationID.x + 1) * (subdivisions + 1) * 5;


    ivec3 v1arr = ivec3 (
        plane.positionsAndUvs[j + i],
        plane.positionsAndUvs[j + i + 1],
        plane.positionsAndUvs[j + i + 2]
    );
    ivec3 v2arr = ivec3 (
        plane.positionsAndUvs[j + i + 3],
        plane.positionsAndUvs[j + i + 4],
        plane.positionsAndUvs[j + i + 5]
    );
    ivec3 v1v3 = ivec3(
        plane.positionsAndUvs[k + i + 0] - v1arr.x,
        plane.positionsAndUvs[k + i + 1] - v1arr.y,
        plane.positionsAndUvs[k + i + 2] - v1arr.z
    );
    ivec3 v1v4 = ivec3(
        plane.positionsAndUvs[k + i + 3] - v1arr.x,
        plane.positionsAndUvs[k + i + 4] - v1arr.y,
        plane.positionsAndUvs[k + i + 5] - v1arr.z
    );

    //   cd = (terrainPositions[k + i + 2] - v1arr[2]) / (terrainPositions[k + i + 3] - v1arr[0]);

    int h = v1arr.z - cd * v1arr.x;             // v1 belongs to the slope

    // facet equations :
    // we compute each facet normal vector
    // the equation of the facet plane is : norm.x * x + norm.y * y + norm.z * z + d = 0
    // we compute the value d by applying the equation to v1 which belongs to the plane
    // then we store the facet equation in a Vector4

    ivec3 v1v2 = v2arr - v1arr;
   
   // v2.subtractToRef(v1, v1v2);
    //v3.subtractToRef(v1, v1v3);

    //v4.subtractToRef(v1, v1v4);

    dvec3 norm1 = normalize(cross(v1v4, v1v3));
    //BABYLON.Vector3.CrossToRef(v1v4, v1v3, norm1);  // caution : CrossToRef uses the Tmp class

    dvec3 norm2 = normalize(cross(v1v2, v1v4));
    // BABYLON.Vector3.CrossToRef(v1v2, v1v4, norm2);

    //norm1.normalize();
    //norm2.normalize();

    double d1 = -(norm1.x * v1arr.x + norm1.y * v1arr.y + norm1.z * v1arr.z);
    double d2 = -(norm2.x * v2arr.x + norm2.y * v2arr.y + norm2.z * v2arr.z);

  //  d1 = -(norm1[0] * v1arr[0] + norm1[1] * v1arr[1] + norm1[2] * v1arr[2]);
  //  d2 = -(norm2[0] * v2arr[0] + norm2[1] * v2arr[1] + norm2[2] * v2arr[2]);

    slopes.numbers[gl_GlobalInvocationID.x * subdivisions + gl_GlobalInvocationID.y] = h;

    facet1.numbers[(gl_GlobalInvocationID.x * subdivisions +  gl_GlobalInvocationID.y) * 4]= float(norm1.x);
    facet1.numbers[(gl_GlobalInvocationID.x * subdivisions +  gl_GlobalInvocationID.y) * 4 +1]= float(norm1.y);
    facet1.numbers[(gl_GlobalInvocationID.x * subdivisions +  gl_GlobalInvocationID.y) * 4+2]= float(norm1.z);
    facet1.numbers[(gl_GlobalInvocationID.x * subdivisions +  gl_GlobalInvocationID.y) * 4+3]= float(d1);

    
    facet2.numbers[(gl_GlobalInvocationID.x * subdivisions +  gl_GlobalInvocationID.y) * 4]= float(norm2.x);
    facet2.numbers[(gl_GlobalInvocationID.x * subdivisions +  gl_GlobalInvocationID.y) * 4 +1]= float(norm2.y);
    facet2.numbers[(gl_GlobalInvocationID.x * subdivisions +  gl_GlobalInvocationID.y) * 4 +2]= float(norm2.z);
    facet2.numbers[(gl_GlobalInvocationID.x * subdivisions +  gl_GlobalInvocationID.y) * 4 +3]= float(d2);

 }