  layout(std430, set = 0, binding = 0) readonly buffer FirstMatrix {
      vec2 size;
      int numbers[];
  } firstMatrix;

  layout(std430, set = 0, binding = 1) readonly buffer SecondMatrix {
      vec2 size;
      float numbers[];
  } secondMatrix;

  layout(std430, set = 0, binding = 2) readonly buffer ThirdMatrix {
      vec2 size;
      float numbers[];
  } thirdMatrix;

  layout(std430, set = 0, binding = 3) buffer ResultMatrix {
      vec2 size;
      int numbers[];
  } resultMatrix;

  void main() {
    resultMatrix.size = vec2(5000, 5000);

    uint x = gl_GlobalInvocationID.x;
    uint z =  gl_GlobalInvocationID.y;

    int cx=int(x)*2 - 5000;
    int cz=int(z)*2 - 5000;

    int col = int(floor((cx+maxX) * subdivisionsX / width));
    int row= int(floor(-(cz+maxZ)*subdivisionsY / height + subdivisionsY));
    int slope = firstMatrix.numbers[row*250 + col];
    vec4 facet;
    if(cz < -1 * cx + slope) {
        facet=vec4(secondMatrix.numbers[(row * 250 + col)*4], secondMatrix.numbers[(row * 250 + col)*4+1], secondMatrix.numbers[(row * 250 + col)*4+2], secondMatrix.numbers[(row * 250 + col)*4+3]);
    } else {
        facet=vec4(thirdMatrix.numbers[(row * 250 + col)*4], thirdMatrix.numbers[(row * 250 + col)*4+1], thirdMatrix.numbers[(row * 250 + col)*4+2], thirdMatrix.numbers[(row * 250 + col)*4+3]);
    }

    float y = -(facet.x * cx + facet.z * cz + facet.w) / facet.y;
    if( y>3 ) {
        resultMatrix.numbers[z*5000 + x]=1;
     } else
     resultMatrix.numbers[z*5000 + x]=0;
  }