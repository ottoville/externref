#version 450
float minX=-5000.0;
float minZ=-5000.0;

float maxX=5000.0;
float maxZ=5000.0;

float subdivisionsX = 250.0;
float subdivisionsY = 250.0;

float width = 10000.0;
float height = 10000.0;

vec4 getFacetAt( float x, float z) {
    // retrieve col and row from x, z coordinates in the ground local system
    
    float col = floor((x+maxX) * subdivisionsX / width);
    float row= floor(-(z+maxZ)*subdivisionsY / height + subdivisionsY);

    ivec4 slope =  texelFetch(slopeArr, ivec2(col,row), 0);
    vec4 facet;
    if(z < -1.0 * x + float(slope.x)) {
        facet = texelFetch(facet1Arr, ivec2(col,row), 0);
    } else {
        facet = texelFetch(facet2Arr, ivec2( col,row), 0);
    }
    return facet;
}
float getHeightAtCoordinates(vec2 xz) {
        vec4 facet = getFacetAt(xz.x, xz.y);
        float y = -(facet.x * xz.x + facet.z * xz.y + facet.w) / facet.y;
        return y;
}
  layout(std430, set = 0, binding = 0) readonly buffer FirstMatrix {
      vec2 size;
      float numbers[];
  } firstMatrix;

  layout(std430, set = 0, binding = 1) readonly buffer SecondMatrix {
      vec2 size;
      float numbers[];
  } secondMatrix;

  layout(std430, set = 0, binding = 2) readonly buffer ThirdMatrix {
      vec2 size;
      float numbers[];
  } thirdMatrix;

  layout(std430, set = 0, binding = 3) buffer ResultMatrix {
      vec2 size;
      float numbers[];
  } resultMatrix;

  void main() {
    resultMatrix.size = vec2(firstMatrix.size.x, secondMatrix.size.y);

    ivec2 resultCell = ivec2(gl_GlobalInvocationID.x, gl_GlobalInvocationID.y);


     for (int x = 0; x < 10000; x++) {
        for (int z = 0; z < 10000; z++) {
            int col = int(floor((x+maxX) * subdivisionsX / width));
            int row= int(floor(-(z+maxZ)*subdivisionsY / height + subdivisionsY));
            float slope = firstMatrix.numbers[col*x + row];
            vec4 facet;
            if(z < -1.0 * x + float(slope)) {
                facet=vec4(secondMatrix.numbers[col*x + row], secondMatrix.numbers[col*x + row+1], secondMatrix.numbers[col*x + row +2], secondMatrix.numbers[col*x + row +3]);
             }
        }
     }



    float result = 0.0;
    for (int i = 0; i < firstMatrix.size.y; i++) {
      int a = i + resultCell.x * int(firstMatrix.size.y);
      int b = resultCell.y + i * int(secondMatrix.size.y);
      result += firstMatrix.numbers[a] * secondMatrix.numbers[b];
    }

    int index = resultCell.y + resultCell.x * int(secondMatrix.size.y);
    resultMatrix.numbers[index] = result;
  }